# ATTENTION : Ce fichier contient des mots de passe par défaut.
# En production, remplacez TOUTES les valeurs ci-dessous et ne
# versionnez JAMAIS ce fichier (.env doit être dans .gitignore).
#
# Copiez ce fichier en .env (non versionné) et adaptez si besoin.
# docker compose le charge automatiquement s'il s'appelle ".env" et se
# trouve à la racine, à côté de docker-compose.yml.

POSTGRES_DB=bibliotheque
POSTGRES_USER=bibliotheque
POSTGRES_PASSWORD=changeme

# --- Ports publiés sur la machine hôte ---
# À changer si un port est déjà pris par un autre projet (ex. BACKEND_PORT=8082).
BACKEND_PORT=8080
FRONTEND_PORT=4200
POSTGRES_PORT=5435

# --- CORS ---
# Origines autorisées pour les requêtes cross-origin (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Keycloak (sécurité / OIDC) ---
# Port hôte de la console d'administration Keycloak
KEYCLOAK_PORT=8081
# Compte admin de Keycloak, créé au PREMIER démarrage uniquement
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# Base de données interne de Keycloak (distincte de celle de l'app)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# --- Profil Spring du backend ---
# Laisser vide en développement (Swagger disponible, messages d'erreur détaillés).
# En production : SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=

# --- Sauvegardes (docker compose --profile ops up -d backup) ---
# Dossier hôte des dumps, heure UTC de la sauvegarde quotidienne, rétention en jours.
BACKUP_DIR=./backups
BACKUP_HEURE=02
BACKUP_JOURS_CONSERVES=7

# --- Observabilité (docker compose --profile observability up -d) ---
# Ports locaux (127.0.0.1 uniquement) et compte admin Grafana, à changer hors poste de dev.
# Mot de passe HTTP Basic partagé par le backend et Prometheus (obligatoire pour ce profil) :
#   openssl rand -base64 24
METRICS_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
